{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "python3 -m http.server 3000 --bind 0.0.0.0 --directory out",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test model.test.js tests/*.test.ts",
    "test:rls": "node scripts/rls-check.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "format:check": "prettier --check app components lib tests/planner.test.ts tests/database.test.ts scripts/e2e.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/supabase-js": "2.118.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
